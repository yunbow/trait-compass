# AI coding assistant local configuration and workspace data
.claude/
.claude.json
.claude-*/
.codex/
.cursor/
.cursorignore
.aider*
.continue/
.windsurf/
.roo/
.opencode/
.cline/
.kilocode/
.github/copilot-instructions.md

# Local environment files
.env
.env.*
!.env.example

# Node / build tooling
node_modules/
dist/
.DS_Store
*.log

# Next.js / OpenNext / Cloudflare
.next/
.open-next/
.wrangler/

# wrangler.toml / wrangler.ingest.toml は各自の Cloudflare アカウント固有の識別子
# (D1 database_id 等)を含む個人設定のため、この公開リポジトリではコミットしない。
# wrangler.toml.example / wrangler.ingest.toml.example をコピーして使う
# (docs/usage/local-setup.md参照)。
app/wrangler.toml
batch/wrangler.ingest.toml

# Test artifacts
# 先頭の "/" でリポジトリ直下の vitest カバレッジ出力のみを対象にする(anchor しないと
# src/app/coverage/・src/features/coverage/ 等の「coverage」という名のソースディレクトリも
# 誤って無視されてしまう)。
/app/coverage/
test-results/
playwright-report/

# RAG定量評価パイプラインのレポート出力(実体は app/eval/reports/)。
eval/reports/
app/eval/reports/

# オープンデータの原本キャッシュ(data/open-data/sources.yaml から再取得できるため、
# 原本ファイル自体はコミットしない。data/open-data/直下のREADME.md・sources.yamlは
# このパターンにマッチしないため残る)。
/data/open-data/*/

# TypeScript
*.tsbuildinfo
next-env.d.ts
