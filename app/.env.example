# ローカル開発用の環境変数サンプル。
# `cp .env.example .env` してから `docker compose up -d` で MinIO を起動する。
# 本番値はコードや .env に書かず、`wrangler secret put <NAME>` で設定する(NFR-11)。
#
# R2(静的画像。ローカルは MinIO を S3 互換 API として使う)

# MinIO の管理者アクセスキー(ローカル固定値。本番は R2 API トークン)
R2_ACCESS_KEY_ID=minioadmin

# MinIO の管理者シークレットキー(ローカル固定値。本番は R2 API トークン)
R2_SECRET_ACCESS_KEY=minioadmin

# バケット名。本番も同名で運用する
R2_BUCKET_NAME=trait-compass

# S3 互換 API のエンドポイント。本番は https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=http://localhost:19000

# 公開配信用 URL のベース(アップロード後に返す画像 URL の組み立てに使用)。
# 本番は https://pub-<hash>.r2.dev またはカスタムドメイン
R2_PUBLIC_URL=http://localhost:19000/trait-compass

# AI/ベクトル抽象レイヤー(LlmClient / Embedder / VectorStore)。詳細は
# docs/designs/architecture-for-engineers.md §4(AIプロバイダ抽象化)参照。
# 「ローカルインデックスはローカル埋め込みで構築する(混在禁止)」src/lib/ai/embedder.ts 参照。

# LLM 実装の切り替え(mock | vertex-direct | vertex-gateway | gemini-mock-server)。
# 通常の開発では mock が既定(クラウド課金・外部送信なし。FR-041)。
LLM_PROVIDER=mock

# Embedder 実装の切り替え(ollama | workers-ai)。workers-ai は Workers 上でのみ動作する。
EMBEDDER_PROVIDER=ollama

# VectorStore 実装の切り替え(qdrant | vectorize)。vectorize は Workers 上でのみ動作する。
VECTOR_PROVIDER=qdrant

# Qdrant(Vectorize 代替)REST API のエンドポイント。docker-compose のホスト公開ポート(16333)に合わせる
QDRANT_URL=http://localhost:16333

# Qdrant のコレクション名
QDRANT_COLLECTION=trait-compass

# Ollama(埋め込み bge-m3)OpenAI 互換 API のエンドポイント。docker-compose のホスト公開ポート(21434)に合わせる
OLLAMA_BASE_URL=http://localhost:21434

# Vertex AI Gemini Flash(LLM_PROVIDER=vertex-direct / vertex-gateway で使用)。
# サービスアカウント JSON は置かず、短命の OAuth2 アクセストークンのみを設定する(NFR-34)。
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_VERTEX_ACCESS_TOKEN=
GOOGLE_VERTEX_MODEL=gemini-2.5-flash

# Cloudflare AI Gateway 経由の Vertex AI エンドポイントのベース URL(LLM_PROVIDER=vertex-gateway で使用)。
# 例: https://gateway.ai.cloudflare.com/v1/{account}/{gateway}
# 本番は AI Gateway 側でログ収集を無効化する設定(cf-aig-collect-log: false)と併用する(NFR-34)。
AI_GATEWAY_URL=

# Gemini API 互換モックサーバー(mock-api-gemini、別リポジトリ)経由で呼び出す場合
# (LLM_PROVIDER=gemini-mock-server で使用)。実際の HTTP 往復・エラーハンドリングを
# 検証したい場合に使う(通常開発は mock で十分)。mock-api-gemini を別途起動しておくこと
# (例: cd ../mock-api-gemini && npm run mock、または docker compose up mock)。
GEMINI_API_BASE_URL=http://localhost:3001
GEMINI_MOCK_API_KEY=mock-api-key-dev1234

# 地図表示(MapView、FR-02A、TICKET-0028)。取得手順: docs/usage/google-maps-api-setup.md
# ブラウザで読み込まれる前提の値のため NEXT_PUBLIC_ を付与している(完全な秘匿はできない)。
# 表示プロバイダー。google または gsi。未指定時は google。
NEXT_PUBLIC_MAP_PROVIDER=google
# 必ず Google Cloud Console 側で HTTP リファラー制限をかけること(google-maps-api-setup.md §2 手順7)。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Advanced Markers 表示に必須のマップID(Google Cloud Console → Google Maps Platform →
# Map Management で作成)。
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# クローズドベータのパスワードゲート(トップ画面 `/` のみ対象)。
# 設定すると `/` へのアクセス時にパスワード入力画面(/beta-gate)を挟む。未設定なら通常通り公開する。
# 本番は `wrangler secret put CLOSED_BETA_PASSWORD` で設定する(NFR-11)。
CLOSED_BETA_PASSWORD=

# OGP(openGraph.images 等)の相対パスを絶対URL化するための metadataBase(src/app/layout.tsx)。
# ローカル・本番ドメイン未確定時は未設定のままでよい(プレースホルダへフォールバックし、
# ビルド・OGP解決自体は破綻しない)。本番は docs/usage/cloudflare-setup.md §6.5 参照。
NEXT_PUBLIC_SITE_URL=
