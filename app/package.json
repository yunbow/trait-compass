{
  "name": "trait-compass-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:upload": "node scripts/upload-static-assets.mjs",
    "build:questions": "node scripts/build-questions.mjs",
    "build:available-municipalities": "node scripts/generate-available-municipalities.mjs",
    "check:edge-runtime": "node scripts/check-no-edge-runtime.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 execute trait-compass --local --file=./db/schema.sql",
    "db:seed:local:manual": "wrangler d1 execute trait-compass --local --file=./db/seed/no-diagnosis-facilities.sql && wrangler d1 execute trait-compass --local --file=./db/seed/adult-benefit-cards.sql && wrangler d1 execute trait-compass --local --file=./db/seed/consultation-desk-tags.sql",
    "db:seed:remote:manual": "wrangler d1 execute trait-compass --remote --file=./db/seed/no-diagnosis-facilities.sql && wrangler d1 execute trait-compass --remote --file=./db/seed/adult-benefit-cards.sql && wrangler d1 execute trait-compass --remote --file=./db/seed/consultation-desk-tags.sql",
    "db:seed:local:tags-open-data": "wrangler d1 execute trait-compass --local --file=./db/seed/consultation-desk-tags-open-data.sql",
    "db:seed:remote:tags-open-data": "wrangler d1 execute trait-compass --remote --file=./db/seed/consultation-desk-tags-open-data.sql",
    "db:seed:local:eval": "wrangler d1 execute trait-compass --local --file=./eval/fixtures/eval-golden-seed.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local:manual",
    "eval": "node --no-warnings eval/run-all.mjs",
    "eval:golden:generate": "node --no-warnings --import ./eval/lib/register.mjs eval/lib/generate-golden.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opennextjs/cloudflare": "1.20.1",
    "@vis.gl/react-google-maps": "^1.9.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^4.20260701.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  }
}
