{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../app/src/*"]
    }
  },
  "files": ["../app/src/types/env.d.ts"],
  "include": ["ingest/**/*.ts"],
  "exclude": ["node_modules", "ingest/**/__tests__/**"]
}
